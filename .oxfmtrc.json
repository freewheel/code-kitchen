{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "sortPackageJson": false,
  "trailingComma": "none",
  "ignorePatterns": [
    "node_modules",
    "/coverage",
    "/.next/",
    "/out/",
    "/build",
    ".DS_Store",
    ".env*",
    ".husky",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "/public",
    ".prettierignore",
    "yarn.lock"
  ]
}
